{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jindesk/1/source",
  "title": "sources/<자료 id>/meta.yaml",
  "description": "받을 때 정해진 사실. 고치지 않는다",
  "type": "object",
  "required": [
    "kind",
    "v",
    "id",
    "original",
    "received",
    "converted",
    "pages",
    "text_layer",
    "build_ups"
  ],
  "properties": {
    "kind": {
      "const": "source"
    },
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^\\d{8}-[0-9a-f]{8}$"
    },
    "original": {
      "type": "object",
      "required": [
        "name",
        "bytes",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "received": {
      "type": "string"
    },
    "converted": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "to",
            "by"
          ],
          "properties": {
            "to": {
              "type": "string"
            },
            "by": {
              "type": "string"
            },
            "app_version": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "pages": {
      "type": "integer",
      "minimum": 0
    },
    "text_layer": {
      "type": "object",
      "required": [
        "by",
        "pages_with_text"
      ],
      "properties": {
        "by": {
          "type": "string"
        },
        "pages_with_text": {
          "type": "integer"
        },
        "ocr": {
          "type": "object",
          "required": [
            "by",
            "pages"
          ],
          "properties": {
            "by": {
              "type": "string"
            },
            "pages": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "build_ups": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      }
    },
    "split_from": {
      "description": "여러 수업이 든 파일을 수업마다 쪼갠 자료의 원래 파일 (자료 나누기)",
      "type": "object",
      "required": [
        "name",
        "sha256",
        "pages",
        "title"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
