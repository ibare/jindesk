{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jindesk/1/syllabus",
  "title": "syllabus/<과목 id>.yaml",
  "description": "강의 계획 목차",
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "code",
        "title"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "src": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "renamed_from": {
          "type": "string"
        },
        "myp": {
          "type": "object",
          "required": [],
          "properties": {
            "key_concept": {
              "type": [
                "string",
                "null"
              ]
            },
            "related_concepts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "global_context": {
              "type": [
                "string",
                "null"
              ]
            },
            "statement_of_inquiry": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "kind",
    "v",
    "subject",
    "programme",
    "sources",
    "items",
    "confirmed",
    "provenance"
  ],
  "properties": {
    "kind": {
      "const": "syllabus"
    },
    "v": {
      "const": 1
    },
    "subject": {
      "type": "string"
    },
    "programme": {
      "type": [
        "string",
        "null"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "confirmed": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "by",
            "at"
          ],
          "properties": {
            "by": {
              "type": "string"
            },
            "at": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
